# Copy to .dev.vars (git-ignored) for local development.
# Values here override "vars" in wrangler.jsonc when running `npm run dev`.

# Local-only auth bypass: every request to http://localhost or http://127.0.0.1 is treated
# as this user (no Cloudflare Access token needed, ALLOWED_EMAILS not consulted).
# Ignored for any other host. Never set this in wrangler.jsonc or in production.
DEV_AUTH_EMAIL=dev@example.com

# Comma-separated allowlist for Cloudflare Access logins (not used by the localhost bypass).
# Production sets it as a secret: npx wrangler secret put ALLOWED_EMAILS
ALLOWED_EMAILS=

# "fake" = deterministic offline generator, "anthropic" = real API calls.
AI_PROVIDER=fake

# Only needed when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
