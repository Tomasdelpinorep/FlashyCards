{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flashcards",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static SPA assets (built by Vite into dist/client). Unknown non-/api paths
  // fall back to index.html; /api/* always goes to the Worker first.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flashcards",
      "database_id": "7b2cfc4b-7dab-4206-bb85-e4b7f35cf2cc",
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret configuration. Secrets (ANTHROPIC_API_KEY) go in `.dev.vars`
  // locally and `wrangler secret put` in production.
  // DEV_AUTH_EMAIL must NEVER be set here; it belongs in .dev.vars only.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://tomas-flash-cards-german.cloudflareaccess.com",
    "ACCESS_AUD": "aca3cb802c435e5dd90050fc6d1c532a1bfca5424a88118f9cec3d53fca3e312",
    // ALLOWED_EMAILS (comma-separated email allowlist) is deliberately NOT a var: the repo is
    // public. Production: `npx wrangler secret put ALLOWED_EMAILS`. Locally: `.dev.vars`.
    // When it is missing or empty, every Access-authenticated request gets 403 (fail closed).
    "AI_PROVIDER": "anthropic",
    "AI_MODEL": "claude-haiku-5-5",
    "AI_USER_DAILY_LIMIT": "200",
    "AI_GLOBAL_DAILY_LIMIT": "2000"
  }
}
